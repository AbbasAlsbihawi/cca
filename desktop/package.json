{
  "name": "claude-accounts",
  "version": "0.1.12",
  "description": "CCA desktop app: a multi-account manager for Claude Code and the Claude desktop app.",
  "author": "Abbas Alsbihawi",
  "license": "MIT",
  "private": true,
  "main": "main/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist:dir": "electron-builder --mac --dir --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:all": "electron-builder --mac --win --x64 --publish never",
    "release": "sh scripts/publish.sh",
    "version": "node scripts/sync-version.js",
    "sync:version": "node scripts/sync-version.js",
    "check:version": "node scripts/sync-version.js --check"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "resedit": "3.1.0"
  },
  "build": {
    "appId": "dev.cca.accounts",
    "productName": "CCA",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "preload.js",
      "package.json",
      "build/icon.png"
    ],
    "asarUnpack": [
      "main/cca-shim.ps1",
      "build/icon.png"
    ],
    "afterPack": "main/afterPack.js",
    "mac": {
      "category": "public.app-category.developer-tools",
      "electronLanguages": [
        "en"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "CCA-${version}-${arch}-mac.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "Claude Accounts",
      "signAndEditExecutable": false,
      "extraResources": [
        {
          "from": "../cca.ps1",
          "to": "cli/cca.ps1"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "CCA-Setup-${version}.exe",
      "include": "build/installer.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "AbbasAlsbihawi",
      "repo": "cca"
    }
  }
}
